+def encode_tool_image_sidecar(content: list) -> str:
+    """Persist image bytes separately from a text-only tool result for wire replay."""
+    images = [
+        part for part in content
+        if isinstance(part, dict)
+        and part.get("type") == "image_url"
+        and isinstance(part.get("image_url"), dict)
+        and str(part["image_url"].get("url", "")).startswith("data:image/")
+    ]
+    return _TOOL_IMAGE_SIDECAR_PREFIX + json.dumps(images, separators=(",", ":")) if images else ""
+
+
+def _decode_tool_image_sidecar(value: Any) -> list:
+    if not isinstance(value, str) or not value.startswith(_TOOL_IMAGE_SIDECAR_PREFIX):
+        return []
+    try:
+        content = json.loads(value[len(_TOOL_IMAGE_SIDECAR_PREFIX):])
+    except (TypeError, ValueError):
+        return []
+    if not isinstance(content, list):
+        return []
+    return [
+        part for part in content
+        if isinstance(part, dict)
+        and part.get("type") == "image_url"
+        and isinstance(part.get("image_url"), dict)
+        and str(part["image_url"].get("url", "")).startswith("data:image/")
+    ]
 
 
