+def refresh_stale_models_dev_for_capability() -> bool:
+    """Refresh a stale catalog before trusting a negative capability verdict.
+
+    Normal lookups serve stale data while refreshing in the background. An image
+    routed as text cannot be recovered later, so this path waits for that refresh.
+    The lock and retry deadline avoid duplicate requests and repeated failures.
+    """
+    now = time.time()
+    if not _models_dev_cache or now - _models_dev_cache_time < _MODELS_DEV_CACHE_TTL or now < _models_dev_retry_after:
+        return False
+    with _models_dev_fetch_lock:
+        now = time.time()
+        if not _models_dev_cache:
+            return False
+        if now - _models_dev_cache_time < _MODELS_DEV_CACHE_TTL:
+            return True  # A background refresh completed while we waited.
+        if now < _models_dev_retry_after:
+            return False
+        _refresh_locked("image capability")
+        return True
+
