+    def _session_config_options(self, state: SessionState) -> list[SessionConfigOptionSelect]:
+        """Model inventory as an ACP ``config_options`` model select.
+
+        T3 Code and newer ACP clients discover selectable models only from typed
+        ``config_options``; the legacy ``models`` state alone leaves their picker with a
+        lone default. Publish the same inventory ``_build_model_state`` advertises so
+        ``session/set_config_option`` can drive Hermes' validated ``switch_model``
+        resolution. Clients that read ``models``/``modes`` (Zed, Claude, Codex) do not
+        need this and keep working unchanged."""
+        picker = self._build_model_state(state)
+        if picker is None or not picker.available_models:
+            return []
+        options = [
+            SessionConfigSelectOption(value=m.model_id, name=m.name, description=m.description)
+            for m in picker.available_models
+        ]
+        current = picker.current_model_id or options[0].value
+        if current not in {option.value for option in options}:
+            current = options[0].value
+        return [
+            SessionConfigOptionSelect(
+                id=self._MODEL_CONFIG_ID,
+                name="Model",
+                category="model",
+                type="select",
+                current_value=current,
+                options=options,
+            )
+        ]
+
