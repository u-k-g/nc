!dotfiles/config/helix/languages.toml
!dotfiles/config/helix/themes/
!dotfiles/config/helix/themes/theme.toml
!dotfiles/config/nushell/
!dotfiles/config/nushell/atuin-fix.nu
!dotfiles/config/nushell/config.nu
!dotfiles/config/nushell/env.nu
!dotfiles/config/nushell/fcdiff.nu
!dotfiles/config/nushell/misc-darwin.nu
!dotfiles/config/nushell/misc.nu
!dotfiles/config/nushell/prompts.nu
