!*.sh
!*.swift
!*.glsl
!*.keymap
!*.yml
!*.yaml
!*.md
!*.png
!*.gif
!*.age
!*.txt

# dotfiles - explicitly track only authored configs, not addon trees
!dotfiles/
!dotfiles/config/
!dotfiles/config/atuin/config.toml
!dotfiles/config/FreeCAD/
!dotfiles/config/FreeCAD/v1-1/
