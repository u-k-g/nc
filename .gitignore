!dotfiles/config/FreeCAD/v1-1/system.cfg
!dotfiles/config/ghostty/
!dotfiles/config/ghostty/config
!dotfiles/config/hammerspoon/
!dotfiles/config/hammerspoon/init.lua
!dotfiles/config/helix/
