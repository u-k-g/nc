// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "soft_wrap": "editor_width",
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "model": [
          "openai/gpt-5.4/high",
          "openai/gpt-5.5/low",
          "openai/gpt-5.4/medium"
        ]
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "cursor": {
      "default_config_options": {
        "mode": "agent"
      },
      "favorite_config_option_values": {
        "model": [
          "gpt-5.4[reasoning=medium,context=272k,fast=false]"
        ]
      },
      "type": "registry"
    }
  },
  "helix_mode": true,
  "diff_view_style": "split",
  "ensure_final_newline_on_save": true,
  "notification_panel": {
    "button": false
  },
  "use_system_window_tabs": true,
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "tabs": {
    "close_position": "right",
    "show_close_button": "hover",
    "file_icons": false,
    "git_status": false
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_branch_icon": false
  },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": true
  },
  "diagnostics": {
    "button": true
  },
  "search": {
    "button": false
  },
  "file_finder": {
    "git_status": true
  },
  "enable_language_server": true,
  "gutter": {
    "breakpoints": true
  },
  "minimum_contrast_for_highlights": 45.0,
  "current_line_highlight": "line",
  "buffer_font_family": "Lilex",
  "restore_on_startup": "last_workspace",
  "redact_private_values": false,
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "keep_window_open",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "disable_ai": false,
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true
    },
    "button": false,
    "dock": "right"
  },
  "debugger": {
    "button": false,
    "dock": "bottom"
  },
  "ssh_connections": [
    {
      "host": "bluevigil@lawndart97.local",
      "projects": [
        {
          "paths": ["/home/bluevigil"]
        },
        {
          "paths": ["/home/bluevigil/mission-controller"]
        }
      ]
    }
  ],
  "outline_panel": {
    "button": false,
    "dock": "right"
  },
  "autosave": "off",
  "vim_mode": false,
  "git_panel": {
    "status_style": "icon",
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null
    },
    "enabled_in_text_threads": false
  },
  "context_servers": {
    "mcp-server-exa-search": {
      "enabled": false,
      "settings": {
        "exa_api_key": ""
      }
    }
  },
  "project_panel": {
    "hide_root": true,
    "show_diagnostics": "errors",
    "scrollbar": {
      "show": "auto"
    },
    "starts_open": false,
    "git_status": true,
    "folder_icons": false,
    "entry_spacing": "standard",
    "file_icons": true,
    "hide_gitignore": false,
    "button": true,
    "dock": "left"
  },
  "icon_theme": "Bearded Icon Theme",
  "agent": {
    "sidebar_side": "left",
    "tool_permissions": {
      "default": "allow"
    },
    "button": true,
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "gpt-5"
    },
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": "always",
    "dock": "right",
    "default_profile": "write",
    "model_parameters": [],
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5"
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Mocha (Blur) [Heavy]",
    "dark": "Gruvbox Dark Soft"
  },
  // "buffer_font_family": "Monaspace Neon",
  // "ui_font_family": "Monaspace Neon",
  "buffer_font_features": {
    "calt": false
  },
  "auto_install_extensions": {
    "git-firefly": true,
    "toml": true,
    "biome": true,
    "html": true,
    "mcp-server-sequential-thinking": true,
    "latex": true,
    "postgres-language-server": true,
    "rose-pine-theme": true,
    "sql": true,
    "zig": true
  },
  "file_types": {
    "C++": ["ino"]
  },
  "lsp": {
    "arduino-language-server": {
      "binary": {
        "path": "~/go/bin/arduino-language-server",
        "arguments": [
          "-clangd",
          "/opt/homebrew/bin/clangd",
          "-cli",
          "/opt/homebrew/bin/arduino-cli",
          "-cli-config",
          "~/.arduino15/arduino-cli.yaml",
          "-fqbn",
          "arduino:avr:uno"
        ]
      }
    },
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": ["--header-insertion=iwyu"]
      },
      "initialization_options": {
        "clangdFileStatus": true,
        "usePlaceholders": true,
        "completeUnimported": true,
        "semanticHighlighting": true
      }
    },
    "vtsls": {
      "enabled": false
    },
    "tailwindcss-language-server": {
      "enabled": false
    },
    "eslint": {
      "enabled": false
    }
  },
  "code_actions_on_format": {
    "source.addMissingImports.clangd": true
  },
  "format_on_save": "off",

  "languages": {
    "C++": {
      "language_servers": ["clangd", "arduino-language-server"]
    },
    "TypeScript": {
      "language_servers": [
        "vtsls",
        "biome",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "biome",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "language_servers": [
        "vtsls",
        "biome",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "JSX": {
      "language_servers": [
        "vtsls",
        "biome",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    }
  }
}
