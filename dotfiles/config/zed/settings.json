{
  "buffer_font_family": "Lilex Nerd Font Mono",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access"
      },
      "type": "registry"
    }
  },
  "which_key": {
    "enabled": true
  },
  "auto_update": true,
  "soft_wrap": "editor_width",
  "helix_mode": true,
  "diff_view_style": "split",
  "ensure_final_newline_on_save": true,
  "use_system_window_tabs": true,
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "tabs": {
    "close_position": "right",
    "show_close_button": "hover",
    "file_icons": false,
    "git_status": true
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false
  },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": true
  },
  "diagnostics": {
    "button": true
  },
  "search": {
    "button": false
  },
  "enable_language_server": true,
  "gutter": {
    "breakpoints": true
  },
  "minimum_contrast_for_highlights": 45.0,
  "current_line_highlight": "line",
  "restore_on_startup": "last_workspace",
  "redact_private_values": false,
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "keep_window_open",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "disable_ai": false,
  "collaboration_panel": {
    "button": false
  },
  "terminal": {
    "shell": "system",
    "toolbar": {
      "breadcrumbs": true
    },
    "button": false,
    "dock": "right"
  },
  "debugger": {
    "button": false,
    "dock": "bottom"
  },
  "outline_panel": {
    "button": false
  },
  "autosave": "off",
  "vim_mode": false,
  "git_panel": {
    "status_style": "icon",
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null
    }
  },
  "project_panel": {
    "hide_root": true,
    "show_diagnostics": "errors",
    "scrollbar": {
      "show": "auto"
    },
    "starts_open": false,
    "git_status": true,
    "folder_icons": false,
    "entry_spacing": "standard",
    "file_icons": true,
    "hide_gitignore": false,
    "button": true,
    "dock": "right"
  },
  "agent": {
    "thinking_display": "always_collapsed",
    "sidebar_side": "left",
    "tool_permissions": {
      "default": "allow"
    },
    "button": true,
    "use_modifier_to_send": true,
    "dock": "left",
    "default_profile": "write"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_features": {
    "calt": false
  },
  "auto_install_extensions": {
    "git-firefly": true
  },
  "format_on_save": "off"
}
